# ─────────────────────────────────────────────────────────────
# LifePilot — Environment Configuration
# Copy to ".env" and fill in values. The app runs with ZERO
# keys (offline mock), but adding free API keys unlocks real AI.
# ─────────────────────────────────────────────────────────────

# App
APP_NAME=LifePilot
ENVIRONMENT=development

# Database (SQLite default = zero setup)
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/lifepilot
DATABASE_URL=sqlite:///./lifepilot.db

# CORS
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ─────────────────────────────────────────────────────────────
# LLM PROVIDER — pick one: groq | gemini | ollama | mock
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq

# Groq (FREE — https://console.groq.com → API Keys)
# 30 requests/minute, Llama 3.3 70B — best free option
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (FREE — https://ai.google.dev → Get API Key)
# 15 requests/minute, Gemini 2.0 Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (FREE, LOCAL — https://ollama.com → install, then: ollama pull qwen2.5:3b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ─────────────────────────────────────────────────────────────
# WEB SCRAPING
# ─────────────────────────────────────────────────────────────
SCRAPING_ENABLED=true
SCRAPING_CACHE_HOURS=24

# Serper.dev (OPTIONAL — 2500 free searches — https://serper.dev)
SERPER_API_KEY=

# ─────────────────────────────────────────────────────────────
# VECTOR DATABASE (ChromaDB — local, no setup needed)
# ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
